# Copy into provisioning/alerting only after configuring a recipient and SMTP.
apiVersion: 1
contactPoints:
  - orgId: 1
    name: DevOps Team
    receivers:
      - uid: devops-email
        type: email
        settings:
          addresses: ${ALERT_EMAIL}
policies:
  - orgId: 1
    receiver: DevOps Team
    group_by: [grafana_folder, alertname]
    routes:
      - receiver: DevOps Team
        object_matchers:
          - [severity, "=", critical]
